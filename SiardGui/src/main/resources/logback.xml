<!DOCTYPE configuration>

<configuration>
    <property name="LOG_FILE" value="${user.home}/SIARD-Suite/siard-suite.log"/>

    <!-- 터미널에는 INFO 이상만 보낸다. DEBUG 는 아래 파일에만 남긴다.
         DEBUG 줄이 전체의 8할이라 터미널에 함께 흘리면 진행과 오류가 묻히고, Windows 콘솔 출력이
         느려 추출 자체를 늦춘다. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <layout class="ch.qos.logback.classic.PatternLayout">
            <pattern>
                %black(%d{ISO8601}) %highlight(%-5level) [%blue(%thread)] %yellow(%logger{36}) %msg%n%throwable
            </pattern>
        </layout>
    </appender>

    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%i</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>9</maxIndex>
        </rollingPolicy>

        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>50MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d{ISO8601} %-5level [%thread] %logger{36} - %msg%n%throwable</pattern>
        </encoder>
    </appender>

    <logger name="ch.admin.bar" level="DEBUG"/>

    <root level="info">
        <appender-ref ref="ROLLING_FILE"/>
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>